    {
      "name": "03_Inventory_Fulfillment",
      "item": [
        {
          "name": "Get User Inventory",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// ========================================================================\r",
                  "// TEST SUITE: Inventory Fulfillment Verification\r",
                  "// ========================================================================\r",
                  "\r",
                  "// Test Case 1: Verify the response status code is 200\r",
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "    });\r",
                  "\r",
                  "// Test Case 2: JSON Structure\r",
                  "pm.test(\"response has user_id and Inventory list\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData).to.have.property('user_id');\r",
                  "    pm.expect(jsonData.inventory).to.be.an(\"array\");\r",
                  "    });\r",
                  "\r",
                  "// Test Case 3: Data Integrity: Verify if item_id: 1 is accredited\r",
                  "    pm.test(\"item_id: 1 is accredited\", function () {\r",
                  "        var jsonData = pm.response.json();\r",
                  "        var expectedItemid = pm.environment.get(\"item_id\");\r",
                  "\r",
                  "        var hasItem = jsonData.inventory.some(function(item){\r",
                  "            return item.item_id == expectedItemid;\r",
                  "        });\r",
                  "\r",
                  "        pm.expect(hasItem).to.be.true;\r",
                  "    });    \r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/inventory/{{user_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "inventory",
                "{{user_id}}"
              ]
            }
