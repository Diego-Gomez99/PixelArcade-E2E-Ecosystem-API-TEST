            {
              "listen": "test",
              "script": {
                "exec": [
                  "// ========================================================================\r",
                  "// TEST SUITE: Checkout & Fulfillment Initiation\r",
                  "// ========================================================================\r",
                  "\r",
                  "// Validate Status Code 201 Created (200 Ok)\r",
                  "pm.test(\"Status code is 201 Created\", function () {\r",
                  "    pm.expect(pm.response.code).to.be.oneOf([200,201]);\r",
                  "});\r",
                  "\r",
                  "// Validate time answer response less than 500ms\r",
                  "pm.test(\"Response time is less than 500ms\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);\r",
                  "    });\r",
                  "\r",
                  "// Save purchase_id dynaminacally and save it in the eviroment\r",
                  "pm.test(\"Save purchase_id in environment\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData).to.have.property(\"purchase_id\");\r",
                  "\r",
                  "    //Asign the purchase_id to the environment variable\r",
                  "    pm.environment.set(\"purchase_id\", jsonData.purchase_id);\r",
                  "    console.log(\"Captured Purchase ID\" + jsonData.purchase_id);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
